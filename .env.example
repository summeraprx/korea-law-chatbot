# Copy this file to ".env" and fill in your keys.

# law.go.kr Open API key ("OC") — apply free at https://open.law.go.kr
# (the OC key you chose on the application form)
LAW_OC=

# Which AI to use:
#   ollama    = free, runs on your own Mac, nothing leaves your computer (less accurate)
#   anthropic = Claude API, paid (set a spend limit), most accurate
AI_PROVIDER=ollama

# --- Ollama settings (free) ---
# Pick by your Mac's memory (Apple menu > About This Mac):
#   8GB: gemma4   |   16GB: gemma4:12b   |   24GB or more: gemma4:26b
# Never use a ":cloud" model: those send conversations to an online service.
OLLAMA_MODEL=gemma4:12b
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384

# --- Claude settings (paid) — only needed when AI_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
VERIFY_MODEL=claude-opus-5-5

# Optional
PORT=3000
RATE_LIMIT_PER_HOUR=30
